# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
build/
dist/

# Data (never commit raw/processed data or datasets)
data/raw/*
data/external/*
data/processed/*
!data/raw/.gitkeep
!data/external/.gitkeep
!data/processed/.gitkeep

# Model weights / checkpoints (track via W&B / releases, not git)
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx
*.engine

# Experiment tracking
wandb/
mlruns/
# ultralytics training run artifacts (plots, batch previews, csv)
runs/

# Outputs / logs
outputs/*
!outputs/.gitkeep
*.log

# Env / secrets
.env
*.env.local

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Type checking / test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
